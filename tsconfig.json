{
  "compilerOptions": {
    /* Modern JS target that matches Node 18+/Vercel */
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],

    /* Project ergonomics */
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },

    /* Module/ESM settings recommended by Next */
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,

    /* TS strictness (keep, these are safe for Next) */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "incremental": true,

    /* Make sure Node types are available in server files/scripts */
    "types": ["node"],

    /* Next plugin */
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.ts"
  ],
  "exclude": ["node_modules"]
}
